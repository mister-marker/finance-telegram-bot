BOT_TOKEN=your_bot_token_here
DATABASE_URL=your_database_url_here

# Public base URL of the deployment — Telegram must be able to reach it.
# In webhook mode the app registers <BASE_WEBHOOK_URL> + WEBHOOK_PATH,
# so a local address such as http://localhost:8000 will NOT work in production.
#
# Production (Render):  https://your-app.onrender.com
# Local development:    expose the app with a tunnel (ngrok, cloudflared)
#                       and put the resulting https URL here.
BASE_WEBHOOK_URL=http://localhost:8000
